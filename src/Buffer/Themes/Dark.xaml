<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#C5FFFFFF" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#5DFFFFFF" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FF000000" />

    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="CardBackgroundFillColorHoverBrush" Color="#15FFFFFF" />
    <SolidColorBrush x:Key="CardBackgroundFillColorPressedBrush" Color="#08FFFFFF" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#19000000" />

    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#15FFFFFF" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#08FFFFFF" />
    <SolidColorBrush x:Key="ControlFillColorDisabledBrush" Color="#0BFFFFFF" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#12FFFFFF" />
    <LinearGradientBrush x:Key="ControlElevationBorderBrush" MappingMode="Absolute" StartPoint="0,0" EndPoint="0,3">
        <GradientStop Offset="0" Color="#18FFFFFF" />
        <GradientStop Offset="1" Color="#12FFFFFF" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#0AFFFFFF" />

    <SolidColorBrush x:Key="FocusStrokeColorOuterBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="FocusStrokeColorInnerBrush" Color="#B3000000" />
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#15FFFFFF" />

    <SolidColorBrush x:Key="FlyoutBackgroundBrush" Color="#FF2C2C2C" />
    <SolidColorBrush x:Key="FlyoutStrokeBrush" Color="#33000000" />
    <SolidColorBrush x:Key="WindowFallbackBrush" Color="#FF2C2C2C" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FF222222" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#FF383838" />
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#4C3A3A3A" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#8BFFFFFF" />
    <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="#FFFCE100" />

</ResourceDictionary>
